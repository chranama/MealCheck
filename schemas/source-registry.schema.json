{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mealcheck.local/schemas/source-registry.schema.json",
  "title": "MealCheck Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "retrieved_at", "sources"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "publisher",
        "url",
        "claims_used"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_version": {
          "type": "string"
        },
        "content_current_as_of": {
          "type": "string"
        },
        "claims_used": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "summary", "source_locator"],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
