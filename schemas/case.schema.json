{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mealcheck.local/schemas/case.schema.json",
  "title": "MealCheck Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "input_mode",
    "settings",
    "guideline_pack_id",
    "guideline_pack_path",
    "nutrient_catalog_id",
    "nutrient_catalog_path",
    "candidate_plan"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "input_mode": {
      "type": "string",
      "enum": ["manual_structured", "profile_generation", "prompt_generation"]
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "guideline_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "guideline_pack_path": {
      "type": "string",
      "minLength": 1
    },
    "nutrient_catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "nutrient_catalog_path": {
      "type": "string",
      "minLength": 1
    },
    "baseline_plan": {
      "type": "string",
      "minLength": 1
    },
    "candidate_plan": {
      "type": "string",
      "minLength": 1
    },
    "generation_prompt": {
      "type": "string"
    },
    "expectations": {
      "$ref": "#/$defs/expectations"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nutrition_targets", "verification_constraints"],
      "properties": {
        "nutrition_targets": {
          "$ref": "#/$defs/nutrition_targets"
        },
        "verification_constraints": {
          "$ref": "#/$defs/verification_constraints"
        }
      }
    },
    "nutrition_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calorie_target_kcal", "protein_target_g"],
      "properties": {
        "calorie_target_kcal": {
          "type": "integer",
          "minimum": 1
        },
        "protein_target_g": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "verification_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "meals_per_day",
        "allergies",
        "excluded_foods",
        "max_sodium_mg_per_day",
        "max_added_sugar_g_per_meal",
        "max_saturated_fat_pct_calories",
        "calorie_tolerance_pct",
        "requires_prep_safety_notes"
      ],
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "meals_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "allergies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_foods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_sodium_mg_per_day": {
          "type": "integer",
          "minimum": 1
        },
        "max_added_sugar_g_per_meal": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_saturated_fat_pct_calories": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "calorie_tolerance_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "requires_prep_safety_notes": {
          "type": "boolean"
        }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_decision": {
          "type": "string",
          "enum": ["pass", "warn", "block"]
        },
        "expected_block_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_warn_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
