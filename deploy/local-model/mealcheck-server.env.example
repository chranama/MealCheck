# MealCheck local-model deployment profile.
# Copy to .mealcheck-local-model/mealcheck-server.env before editing.
# This file contains no secrets.

# Canonical profile: use a host-local Postgres service, matching production's
# non-Docker service shape. If using the optional disposable Compose fallback,
# change the port to 5433.
DATABASE_URL='postgres://mealcheck:mealcheck@127.0.0.1:5432/mealcheck?sslmode=disable'

MEALCHECK_ADDR='127.0.0.1:8080'
MEALCHECK_STORE='postgres'
MEALCHECK_DATA_DIR='.mealcheck-local-model'
MEALCHECK_ARTIFACT_DIR='.mealcheck-local-model/artifacts'

MEALCHECK_ALLOWED_ORIGIN='http://127.0.0.1:4173'
MEALCHECK_ACCESS_MODE='public_byok'
MEALCHECK_HOSTED_MODE='local_model'
MEALCHECK_INVITE_REQUIRED='false'

# The profile runner resolves "auto" from MEALCHECK_LOCAL_MODEL_BASE_URL/models.
# When running mealcheck-server manually, replace this with the model id returned
# by the local llama.cpp endpoint.
MEALCHECK_LOCAL_MODEL_ENABLED='true'
MEALCHECK_LOCAL_MODEL_BASE_URL='http://127.0.0.1:11435/v1'
MEALCHECK_LOCAL_MODEL_NAME='auto'
MEALCHECK_LOCAL_MODEL_TIMEOUT='240s'
MEALCHECK_LOCAL_MODEL_MAX_INPUT_CHARS='3000'
MEALCHECK_LOCAL_MODEL_MAX_SOURCE_ITEMS='20'
MEALCHECK_LOCAL_MODEL_MAX_OUTPUT_TOKENS='1536'

MEALCHECK_QUEUE_SIZE='3'
MEALCHECK_MAX_CASES_PER_RUN='20'
MEALCHECK_MAX_UPLOAD_BYTES='1000000'
MEALCHECK_RUN_TIMEOUT='10m'
MEALCHECK_RETENTION='168h'
MEALCHECK_WORKER_POLL='1s'
MEALCHECK_CLEANUP_INTERVAL='1h'
