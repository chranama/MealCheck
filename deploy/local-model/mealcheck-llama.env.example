# MealCheck local-model llama.cpp profile.
# Copy to .mealcheck-local-model/mealcheck-llama.env before editing.
# This file assumes commands run from the repository root.

LLAMA_SERVER_BIN='llama-server'
LLAMA_MODEL_PATH='.mealcheck-local-model/models/Qwen3-0.6B-Q4_K_M.gguf'
LLAMA_LOG_DIR='.mealcheck-local-model/logs'

LLAMA_HOST='127.0.0.1'
LLAMA_PORT='11435'

LLAMA_CTX_SIZE='4096'
LLAMA_THREADS='4'
LLAMA_BATCH_SIZE='256'
LLAMA_UBATCH_SIZE='64'
LLAMA_GPU_LAYERS='0'
LLAMA_PARALLEL='1'
LLAMA_CACHE_RAM='512'

# Optional space-separated llama-server arguments for local experiments.
LLAMA_EXTRA_ARGS=''
