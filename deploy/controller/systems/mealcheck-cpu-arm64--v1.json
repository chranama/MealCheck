{
  "apiVersion": "mealcheck.dev/system/v1alpha1",
  "name": "mealcheck-cpu-arm64",
  "version": "v1",
  "architecture": "arm64",
  "applicationRole": "api",
  "parameters": {
    "modelPath": {
      "type": "string"
    },
    "secretProfile": {
      "type": "string",
      "default": "mealcheck-lab",
      "allowed": [
        "mealcheck-lab"
      ]
    },
    "apiHostPort": {
      "type": "integer",
      "default": 18080,
      "minimum": 18080,
      "maximum": 18089
    },
    "modelThreads": {
      "type": "integer",
      "default": 8,
      "minimum": 1,
      "maximum": 8
    },
    "modelNanoCPUs": {
      "type": "integer",
      "default": 8000000000,
      "minimum": 1000000000,
      "maximum": 8000000000
    }
  },
  "resources": [
    {
      "role": "network",
      "kind": "network"
    },
    {
      "role": "database-volume",
      "kind": "volume"
    },
    {
      "role": "artifact-volume",
      "kind": "volume"
    },
    {
      "role": "postgres",
      "kind": "container",
      "dependsOn": [
        "network",
        "database-volume"
      ],
      "container": {
        "image": "docker.io/library/postgres@sha256:5d11ffb37e58a7c9a2285359e50f7674e216c99b9114e47b0e7f21187c11252c",
        "nanoCPUs": 2000000000,
        "memoryBytes": 1073741824,
        "networkRole": "network",
        "aliases": [
          "postgres"
        ],
        "environment": [
          "POSTGRES_DB=mealcheck",
          "POSTGRES_USER=mealcheck",
          "POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password"
        ],
        "mounts": [
          {
            "kind": "secret",
            "source": "postgres-password",
            "target": "/run/secrets/postgres-password",
            "readOnly": true
          },
          {
            "kind": "volume",
            "source": "database-volume",
            "target": "/var/lib/postgresql/data",
            "readOnly": false
          }
        ],
        "probe": {
          "kind": "exec",
          "command": [
            "pg_isready",
            "-U",
            "mealcheck",
            "-d",
            "mealcheck"
          ]
        }
      }
    },
    {
      "role": "model",
      "kind": "container",
      "dependsOn": [
        "network"
      ],
      "container": {
        "image": "ghcr.io/ggml-org/llama.cpp@sha256:a9bc9f7f3832c18a3d8f74a37d495c0ca4e40fe188b774d2bf08a279e502a943",
        "nanoCPUs": 8000000000,
        "cpuParameter": "modelNanoCPUs",
        "memoryBytes": 4294967296,
        "networkRole": "network",
        "aliases": [
          "model"
        ],
        "args": [
          "--model",
          "/models/model.gguf",
          "--alias",
          "mealcheck-lab-model",
          "--host",
          "0.0.0.0",
          "--port",
          "8080",
          "--ctx-size",
          "8192",
          "--threads",
          "${modelThreads}",
          "--n-gpu-layers",
          "0"
        ],
        "mounts": [
          {
            "kind": "model",
            "source": "${modelPath}",
            "target": "/models/model.gguf",
            "readOnly": true
          }
        ],
        "probe": {
          "kind": "model",
          "path": "/health",
          "port": 8080
        }
      }
    },
    {
      "role": "api",
      "kind": "container",
      "dependsOn": [
        "network",
        "artifact-volume",
        "postgres",
        "model"
      ],
      "container": {
        "image": "localhost:15000/mealcheck@sha256:3d7ba167fc373f348e98bed7a73e865d981f334f7e37ec07e4da525c8ffb795f",
        "user": "10001:10001",
        "nanoCPUs": 2000000000,
        "memoryBytes": 2147483648,
        "networkRole": "network",
        "aliases": [
          "api"
        ],
        "environment": [
          "MEALCHECK_ADDR=0.0.0.0:8080",
          "MEALCHECK_STORE=postgres",
          "MEALCHECK_HOSTED_MODE=local_model",
          "MEALCHECK_LOCAL_MODEL_ENABLED=true",
          "MEALCHECK_LOCAL_MODEL_BASE_URL=http://model:8080/v1",
          "MEALCHECK_LOCAL_MODEL_NAME=mealcheck-lab-model",
          "MEALCHECK_DATA_DIR=/var/lib/mealcheck",
          "MEALCHECK_ARTIFACT_DIR=/var/lib/mealcheck/artifacts",
          "MEALCHECK_FNDDS_FALLBACK_PATH=/opt/mealcheck/data/reference/fndds-2021-2023/fndds.sqlite"
        ],
        "mounts": [
          {
            "kind": "secret",
            "source": "database-url",
            "target": "/run/secrets/database-url",
            "readOnly": true
          },
          {
            "kind": "volume",
            "source": "artifact-volume",
            "target": "/var/lib/mealcheck/artifacts",
            "readOnly": false
          }
        ],
        "ports": [
          {
            "containerPort": 8080,
            "hostPort": 18080,
            "hostIP": "127.0.0.1",
            "hostPortParameter": "apiHostPort"
          }
        ],
        "probe": {
          "kind": "application",
          "path": "/api/status",
          "port": 8080,
          "components": [
            "meal_check_submission",
            "ai_meal_normalization",
            "nutrition_allergen_checking"
          ]
        }
      }
    }
  ]
}
