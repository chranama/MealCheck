{
  "apiVersion": "mealcheck.dev/system/v1alpha1",
  "name": "mealcheck-production-amd64",
  "version": "v2",
  "architecture": "amd64",
  "applicationRole": "api",
  "parameters": {
    "modelPath": {
      "type": "string"
    },
    "secretProfile": {
      "type": "string",
      "default": "mealcheck-production",
      "allowed": [
        "mealcheck-production"
      ]
    },
    "apiHostPort": {
      "type": "integer",
      "default": 18080,
      "minimum": 18080,
      "maximum": 18080
    },
    "modelThreads": {
      "type": "integer",
      "default": 2,
      "minimum": 2,
      "maximum": 2
    },
    "modelNanoCPUs": {
      "type": "integer",
      "default": 2000000000,
      "minimum": 2000000000,
      "maximum": 2000000000
    }
  },
  "resources": [
    {
      "role": "network",
      "kind": "network"
    },
    {
      "role": "database-volume",
      "kind": "volume"
    },
    {
      "role": "artifact-volume",
      "kind": "volume"
    },
    {
      "role": "postgres",
      "kind": "container",
      "dependsOn": [
        "network",
        "database-volume"
      ],
      "container": {
        "image": "docker.io/library/postgres@sha256:6e5a6518f9d2ff9e9f4cba2a5a87d8f41b0f067f6f92ac847c344351a6c8d923",
        "nanoCPUs": 1000000000,
        "memoryBytes": 536870912,
        "networkRole": "network",
        "aliases": [
          "postgres"
        ],
        "environment": [
          "POSTGRES_DB=mealcheck",
          "POSTGRES_USER=mealcheck",
          "POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password"
        ],
        "mounts": [
          {
            "kind": "secret",
            "source": "postgres-password",
            "target": "/run/secrets/postgres-password",
            "readOnly": true
          },
          {
            "kind": "volume",
            "source": "database-volume",
            "target": "/var/lib/postgresql/data",
            "readOnly": false
          }
        ],
        "probe": {
          "kind": "exec",
          "command": [
            "pg_isready",
            "-U",
            "mealcheck",
            "-d",
            "mealcheck"
          ]
        }
      }
    },
    {
      "role": "model",
      "kind": "container",
      "dependsOn": [
        "network"
      ],
      "container": {
        "image": "ghcr.io/ggml-org/llama.cpp@sha256:a48c794aabc51dc5f9663c358b946b79d4cc02de67ab4d508c2c850fd0bc20f8",
        "nanoCPUs": 2000000000,
        "cpuParameter": "modelNanoCPUs",
        "memoryBytes": 2147483648,
        "networkRole": "network",
        "aliases": [
          "model"
        ],
        "args": [
          "--model",
          "/models/model.gguf",
          "--alias",
          "mealcheck-production-model",
          "--host",
          "0.0.0.0",
          "--port",
          "8080",
          "--ctx-size",
          "4096",
          "--threads",
          "${modelThreads}",
          "--batch-size",
          "256",
          "--ubatch-size",
          "64",
          "--parallel",
          "1",
          "--cache-ram",
          "512",
          "--n-gpu-layers",
          "0"
        ],
        "mounts": [
          {
            "kind": "model",
            "source": "${modelPath}",
            "target": "/models/model.gguf",
            "readOnly": true
          }
        ],
        "probe": {
          "kind": "model",
          "path": "/health",
          "port": 8080
        }
      }
    },
    {
      "role": "api",
      "kind": "container",
      "dependsOn": [
        "network",
        "artifact-volume",
        "postgres",
        "model"
      ],
      "container": {
        "image": "localhost:15000/mealcheck@sha256:ee440cc40a24788b317d4323f35eacdf5b7ddba6e8e0841a473ad1973eec73d3",
        "user": "10001:10001",
        "nanoCPUs": 1000000000,
        "memoryBytes": 805306368,
        "networkRole": "network",
        "aliases": [
          "api"
        ],
        "environment": [
          "MEALCHECK_ADDR=0.0.0.0:8080",
          "MEALCHECK_STORE=postgres",
          "MEALCHECK_HOSTED_MODE=local_model",
          "MEALCHECK_LOCAL_MODEL_ENABLED=true",
          "MEALCHECK_LOCAL_MODEL_BASE_URL=http://model:8080/v1",
          "MEALCHECK_LOCAL_MODEL_NAME=mealcheck-production-model",
          "MEALCHECK_DATA_DIR=/var/lib/mealcheck",
          "MEALCHECK_ARTIFACT_DIR=/var/lib/mealcheck/artifacts",
          "MEALCHECK_FNDDS_FALLBACK_PATH=/opt/mealcheck/data/reference/fndds-2021-2023/fndds.sqlite",
          "MEALCHECK_ACCESS_MODE=public_byok",
          "MEALCHECK_ALLOWED_ORIGIN=https://mealcheck.dev",
          "MEALCHECK_CLEANUP_INTERVAL=1h",
          "MEALCHECK_INVITE_REQUIRED=false",
          "MEALCHECK_LOCAL_MODEL_MAX_INPUT_CHARS=3000",
          "MEALCHECK_LOCAL_MODEL_MAX_OUTPUT_TOKENS=1536",
          "MEALCHECK_LOCAL_MODEL_MAX_SOURCE_ITEMS=20",
          "MEALCHECK_LOCAL_MODEL_TIMEOUT=240s",
          "MEALCHECK_MAX_CASES_PER_RUN=20",
          "MEALCHECK_MAX_UPLOAD_BYTES=1000000",
          "MEALCHECK_QUEUE_SIZE=3",
          "MEALCHECK_RETENTION=168h",
          "MEALCHECK_RUN_TIMEOUT=10m",
          "MEALCHECK_WORKER_POLL=1s"
        ],
        "mounts": [
          {
            "kind": "secret",
            "source": "database-url",
            "target": "/run/secrets/database-url",
            "readOnly": true
          },
          {
            "kind": "volume",
            "source": "artifact-volume",
            "target": "/var/lib/mealcheck/artifacts",
            "readOnly": false
          }
        ],
        "ports": [
          {
            "containerPort": 8080,
            "hostPort": 18080,
            "hostIP": "127.0.0.1",
            "hostPortParameter": "apiHostPort"
          }
        ],
        "probe": {
          "kind": "application",
          "path": "/api/status",
          "port": 8080,
          "components": [
            "meal_check_submission",
            "ai_meal_normalization",
            "nutrition_allergen_checking"
          ]
        }
      }
    }
  ]
}
