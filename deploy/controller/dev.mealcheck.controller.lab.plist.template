<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.mealcheck.controller.lab</string>
  <key>ProgramArguments</key><array>
    <string>@BINARY@</string><string>daemon</string>
    <string>--state-dir</string><string>@STATE@</string>
    <string>--socket</string><string>@SOCKET@</string>
    <string>--engine</string><string>@ENGINE@</string>
    <string>--secret-root</string><string>@SECRETS@</string>
    <string>--model-roots</string><string>@MODELS@</string>
    <string>--registries</string><string>@REGISTRIES@</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>@LOGS@/stdout.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/stderr.log</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict></plist>
