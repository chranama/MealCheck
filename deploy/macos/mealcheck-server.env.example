# MealCheck backend production environment template.
# Copy to /Users/chranama-server/MealCheck-data/mealcheck-server.env on the MacBook.
# Replace placeholders locally. Do not commit real secrets.

DATABASE_URL='postgres://mealcheck:<POSTGRES_PASSWORD>@localhost:5432/mealcheck?sslmode=disable'

MEALCHECK_ADDR='127.0.0.1:8080'
MEALCHECK_STORE='postgres'
MEALCHECK_DATA_DIR='/Users/chranama-server/MealCheck-data'
MEALCHECK_ARTIFACT_DIR='/Users/chranama-server/MealCheck-data/artifacts'

# Optional exact-match fallback for eligible, preprocessed FNDDS foods.
# Leave unset to use only the reviewed local catalog.
# MEALCHECK_FNDDS_FALLBACK_PATH='/Users/chranama-server/MealCheck/data/reference/fndds-2021-2023/fndds.sqlite'

MEALCHECK_ALLOWED_ORIGIN='https://mealcheck.dev'
MEALCHECK_ACCESS_MODE='public_byok'
MEALCHECK_HOSTED_MODE='local_model'
MEALCHECK_INVITE_REQUIRED='false'

# Hosted local-model mode uses the private llama.cpp service. Do not expose this
# endpoint publicly and do not accept user-supplied local model base URLs.
MEALCHECK_LOCAL_MODEL_ENABLED='true'
MEALCHECK_LOCAL_MODEL_BASE_URL='http://127.0.0.1:11435/v1'
MEALCHECK_LOCAL_MODEL_NAME='/Users/chranama-server/MealCheck-data/models/Qwen3-0.6B-Q4_K_M.gguf'
MEALCHECK_LOCAL_MODEL_TIMEOUT='240s'
MEALCHECK_LOCAL_MODEL_MAX_INPUT_CHARS='6000'
MEALCHECK_LOCAL_MODEL_MAX_OUTPUT_TOKENS='1536'

# Private deployments can switch to invite-required mode and create per-user
# access codes with `mealcheck invite create` against the Postgres store.
# MEALCHECK_ACCESS_MODE='invite_required'
# MEALCHECK_INVITE_REQUIRED='true'
#
# Optional legacy shared access code.
# MEALCHECK_INVITE_TOKEN=''

MEALCHECK_QUEUE_SIZE='3'
MEALCHECK_MAX_CASES_PER_RUN='20'
MEALCHECK_MAX_UPLOAD_BYTES='1000000'
MEALCHECK_RUN_TIMEOUT='10m'
MEALCHECK_RETENTION='168h'
MEALCHECK_WORKER_POLL='1s'
MEALCHECK_CLEANUP_INTERVAL='1h'
