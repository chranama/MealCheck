# MealCheck local llama.cpp model service environment template.
# Copy to /Users/chranama-server/MealCheck-data/mealcheck-llama.env on the MacBook.
# This file contains no secrets, but production copies are still machine-local.

LLAMA_SERVER_BIN='/Users/chranama-server/llama.cpp/build/bin/llama-server'
LLAMA_MODEL_PATH='/Users/chranama-server/MealCheck-data/models/Qwen3-0.6B-Q4_K_M.gguf'

LLAMA_HOST='127.0.0.1'
LLAMA_PORT='11435'

# Production default favors heterogeneous hosted inputs over the fastest
# one-day smoke-test setting. Use 1024 for short-input latency experiments.
LLAMA_CTX_SIZE='2048'
LLAMA_THREADS='4'
LLAMA_BATCH_SIZE='256'
LLAMA_UBATCH_SIZE='64'
LLAMA_GPU_LAYERS='0'
LLAMA_PARALLEL='1'
LLAMA_CACHE_RAM='512'

# Optional space-separated llama-server arguments for local experiments.
# Keep empty for production unless a candidate flag has been measured.
LLAMA_EXTRA_ARGS=''
